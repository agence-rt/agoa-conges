{
  "name": "agoa-conges",
  "productName": "AGOA CG",
  "version": "0.1.0",
  "description": "AGOA CG : calendrier des congés de l'agence (mois, année, compte rendu mensuel).",
  "author": "SELARL Rémi Thollet Architecte",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/agence-rt/agoa-conges.git"
  },
  "private": true,
  "main": "main.js",
  "agoa": {
    "deploiement": 1
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "icon": "python3 scripts/make_icon.py",
    "dist": "electron-builder --win",
    "deploy": "node scripts/deploy.js"
  },
  "dependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "electron": "43.7.9",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "fr.remithollet.agoa.cg",
    "productName": "AGOA CG",
    "copyright": "Agence Rémi Thollet",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "src/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AGOA CG",
      "runAfterFinish": true,
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036",
      "multiLanguageInstaller": true,
      "deleteAppDataOnUninstall": false
    },
    "artifactName": "AGOA-CG-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "agence-rt",
        "repo": "agoa-conges",
        "releaseType": "release"
      }
    ]
  }
}
